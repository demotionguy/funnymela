# Razorpay (Dashboard > Settings > API Keys). Use TEST keys first.
RZP_KEY_ID=rzp_test_xxxxxxxxxxxx
RZP_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard > Settings > Webhooks: URL = https://YOUR-API/webhook , event = payment.captured , set a secret and put it here
RZP_WEBHOOK_SECRET=choose_a_long_random_string

# Supabase (Project Settings > API). SERVICE key stays ONLY on the server, never in the browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=xxxxxxxxxxxxxxxx

# Your hosted frontend + admin page origins (comma separated, no trailing slash)
SITE_ORIGIN=https://funnymela.example.com,https://admin.funnymela.example.com

# Optional admin login (ID + password). Make the hash with:
# node -e "console.log(require('crypto').scryptSync('YOUR_PASSWORD','YOUR_SALT',32).toString('hex'))"
ADMIN_ID=owner
ADMIN_PASS_SALT=YOUR_SALT
ADMIN_PASS_HASH=paste_hash_here
ADMIN_TOKEN_SECRET=another_long_random_string
PORT=3000
